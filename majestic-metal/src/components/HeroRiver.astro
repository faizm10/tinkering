---
/**
 * Layered wave river — horizontal parallax scroll + surface motion.
 * All motion is CSS keyframes (always visible, no JS required).
 */
---

<div class="hero-river" data-hero-river aria-hidden="true">
  <div class="hero-river__bed"></div>

  <div class="hero-river__layers">
    <div class="hero-river__layer hero-river__layer--back" data-river-layer="back">
      <div class="hero-river__track">
        <svg class="hero-river__svg" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-river__wave"
            d="M0,72 C120,48 240,88 360,58 480,78 600,42 720,70 840,50 960,76 1080,54 1200,68 L1200,120 L0,120 Z"
            fill="rgba(118, 158, 198, 0.55)"></path>
        </svg>
        <svg class="hero-river__svg" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-river__wave"
            d="M0,72 C120,48 240,88 360,58 480,78 600,42 720,70 840,50 960,76 1080,54 1200,68 L1200,120 L0,120 Z"
            fill="rgba(118, 158, 198, 0.55)"></path>
        </svg>
      </div>
    </div>

    <div class="hero-river__layer hero-river__layer--mid" data-river-layer="mid">
      <div class="hero-river__track">
        <svg class="hero-river__svg" viewBox="0 0 1200 100" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-river__wave"
            d="M0,58 C100,34 200,62 300,38 400,54 500,32 600,50 700,36 800,52 900,40 1000,56 1100,44 1200,52 L1200,100 L0,100 Z"
            fill="rgba(98, 142, 188, 0.68)"></path>
        </svg>
        <svg class="hero-river__svg" viewBox="0 0 1200 100" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-river__wave"
            d="M0,58 C100,34 200,62 300,38 400,54 500,32 600,50 700,36 800,52 900,40 1000,56 1100,44 1200,52 L1200,100 L0,100 Z"
            fill="rgba(98, 142, 188, 0.68)"></path>
        </svg>
      </div>
    </div>

    <div class="hero-river__layer hero-river__layer--front" data-river-layer="front">
      <div class="hero-river__track">
        <svg class="hero-river__svg" viewBox="0 0 1200 88" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-river__wave hero-river__wave--shine"
            d="M0,48 C90,28 180,52 270,30 360,44 450,26 540,40 630,28 720,42 810,30 900,44 990,32 1080,40 1170,34 1200,38 L1200,88 L0,88 Z"
            fill="rgba(82, 128, 172, 0.78)"></path>
        </svg>
        <svg class="hero-river__svg" viewBox="0 0 1200 88" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-river__wave hero-river__wave--shine"
            d="M0,48 C90,28 180,52 270,30 360,44 450,26 540,40 630,28 720,42 810,30 900,44 990,32 1080,40 1170,34 1200,38 L1200,88 L0,88 Z"
            fill="rgba(82, 128, 172, 0.78)"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="hero-river__shimmer" data-river-shimmer aria-hidden="true"></div>

  <div class="hero-river__ripples" data-river-ripples>
    <span class="hero-river__ripple"></span>
    <span class="hero-river__ripple"></span>
    <span class="hero-river__ripple"></span>
    <span class="hero-river__ripple"></span>
    <span class="hero-river__ripple"></span>
    <span class="hero-river__ripple"></span>
  </div>
</div>
