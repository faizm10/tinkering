---
import HeroRiver from "./HeroRiver.astro";

const kimSrc = "/kim-yoo-jung.png";
---

<div class="hero-visual" data-hero-visual>
  <HeroRiver />
  <div class="hero-glow" data-hero-glow></div>
  <div class="hero-kim-wrap" data-hero-kim-wrap>
    <img
      class="hero-img hero-img--kim"
      data-hero-kim
      src={kimSrc}
      alt="Kim Yoo-jung"
      width="533"
      height="800"
      loading="eager"
    />
  </div>
</div>

<script>
  import gsap from "gsap";

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: "(prefers-reduced-motion: reduce)",
      finePointer: "(hover: hover) and (pointer: fine)",
    },
    (context) => {
      const { reduceMotion, finePointer } = context.conditions;
      const root = document.querySelector("[data-hero-visual]");
      if (!root) return;

      const kimWrap = root.querySelector("[data-hero-kim-wrap]");
      const kim = root.querySelector("[data-hero-kim]");
      const glow = root.querySelector("[data-hero-glow]");
      const explore = document.querySelector(".landing .explore-btn");
      const landing = document.querySelector(".landing");

      const river = root.querySelector("[data-hero-river]");

      if (reduceMotion) {
        gsap.set([kimWrap, kim, glow, explore].filter(Boolean), {
          clearProps: "all",
        });
        return;
      }

      gsap.set(kimWrap, { transformOrigin: "50% 100%" });
      gsap.set(glow, { autoAlpha: 0.35 });

      const intro = gsap.timeline({ defaults: { ease: "power3.out" } });

      intro.from(kim, {
        autoAlpha: 0,
        scale: 1.08,
        x: -18,
        y: 36,
        rotation: -2.5,
        transformOrigin: "50% 100%",
        duration: 2.1,
      });

      if (explore) {
        intro.from(explore, { autoAlpha: 0, y: -14, duration: 1 }, "-=1.4");
      }

      intro.from(glow, { autoAlpha: 0, duration: 1.8 }, "-=2");

      gsap.to(glow, {
        autoAlpha: 0.88,
        duration: 3.2,
        ease: "sine.inOut",
        repeat: -1,
        yoyo: true,
        delay: 1.5,
      });

      const kimIdle = gsap.timeline({
        repeat: -1,
        defaults: { ease: "sine.inOut" },
        delay: 2,
      });

      kimIdle
        .to(kim, {
          y: -16,
          x: 10,
          rotation: 1.8,
          scale: 1.018,
          duration: 4.8,
        })
        .to(kim, {
          y: -8,
          x: -12,
          rotation: -1.4,
          scale: 1.012,
          duration: 4.4,
        })
        .to(kim, {
          y: 6,
          x: 4,
          rotation: 0.6,
          scale: 1,
          duration: 4.2,
        })
        .to(kim, {
          y: -4,
          x: -2,
          rotation: -0.4,
          scale: 1.008,
          duration: 3.6,
        });

      if (finePointer && landing && kimWrap) {
        const parallaxX = gsap.quickTo(kimWrap, "x", {
          duration: 1.35,
          ease: "power3.out",
        });
        const parallaxY = gsap.quickTo(kimWrap, "y", {
          duration: 1.35,
          ease: "power3.out",
        });

        const onMove = (event) => {
          const rect = landing.getBoundingClientRect();
          const nx = (event.clientX - rect.left) / rect.width - 0.5;
          const ny = (event.clientY - rect.top) / rect.height - 0.5;
          parallaxX(nx * 22);
          parallaxY(ny * 12);
        };

        const onLeave = () => {
          parallaxX(0);
          parallaxY(0);
        };

        landing.addEventListener("pointermove", onMove);
        landing.addEventListener("pointerleave", onLeave);

        return () => {
          landing.removeEventListener("pointermove", onMove);
          landing.removeEventListener("pointerleave", onLeave);
        };
      }
    },
  );
</script>
